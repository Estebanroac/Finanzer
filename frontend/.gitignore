# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# /out/ is the pre-built static export served by FastAPI on Render — it MUST
# be committed (build.sh does not rebuild the frontend), so it is NOT ignored.

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright: resultados y capturas de cada pasada del e2e (las de una etapa se versionan con
# `npm run capturas:etapa -- <etapa>`, que las copia a docs/rediseno/capturas-<etapa>/).
/test-results/
/playwright-report/
/.legacy-snapshots/

# verificación V1 (resultados por ticker; la matriz va a docs/rediseno/verificacion)
/v1-results/
